{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "tabWidth": 2,
  "printWidth": 100,
  "sortPackageJson": false,
  "sortTailwindcss": {},
  "ignorePatterns": [
    "*.tsbuildinfo",
    "coverage/**",
    "dist",
    "node_modules",
    "public/vendor/**",
    "src/collection-templates/raw/**",
    "src/lib/settingsConformance.json",
    "vendor/**"
  ]
}
