{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>prairie-server/prairie-server//renovate-presets/default"],
  "enabledManagers": ["github-actions", "gomod", "npm", "cargo"],
  "postUpdateOptions": ["gomodTidy"],
  "ignorePaths": [
    "**/node_modules/**",
    "web/vendor/**",
    "internal/compat/**"
  ],
  "packageRules": [
    {
      "description": "typescript-eslint peer range is still <6.1; stay on TypeScript 6.0.x until that catches up",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<6.1"
    }
  ]
}
