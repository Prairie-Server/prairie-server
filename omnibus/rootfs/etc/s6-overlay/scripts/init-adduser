#!/command/with-contenv bash
# shellcheck shell=bash
# Map the prairie account onto PUID and PGID and give it access to any GPU
# devices passed into the container.
set -euo pipefail
# shellcheck source=omnibus/rootfs/etc/prairie-omnibus/lib.sh
source /etc/prairie-omnibus/lib.sh

PUID="${PUID:-911}"
PGID="${PGID:-911}"
if [[ ! "$PUID" =~ ^[0-9]+$ || ! "$PGID" =~ ^[0-9]+$ ]]; then
  echo "PUID and PGID must be numeric (got PUID=$PUID PGID=$PGID)" >&2
  exit 1
fi

# Another account on the same uid would make the kernel report that name for
# Prairie's processes, which breaks PostgreSQL peer authentication.
other="$(getent passwd "$PUID" | cut -d: -f1 || true)"
if [[ -n "$other" && "$other" != "prairie" ]]; then
  echo "PUID $PUID is already used by the $other account in this image; choose another uid" >&2
  exit 1
fi

[[ "$(id -g prairie)" == "$PGID" ]] || groupmod -o -g "$PGID" prairie
[[ "$(id -u prairie)" == "$PUID" ]] || usermod -o -u "$PUID" prairie

for g in video render; do
  if getent group "$g" >/dev/null; then
    usermod -aG "$g" prairie
  fi
done

# Devices bind-mounted from the host carry host group ids. Create a matching
# group when none exists so the prairie user can open them.
for dev in /dev/dri/* /dev/nvidia*; do
  [[ -c "$dev" ]] || continue
  gid="$(stat -c %g "$dev")"
  [[ "$gid" == 0 ]] && continue
  group="$(getent group "$gid" | cut -d: -f1 || true)"
  if [[ -z "$group" ]]; then
    group="dev$gid"
    groupadd -g "$gid" "$group"
  fi
  usermod -aG "$group" prairie
done

# Prairie reads the media as this account; the Compose stack's image ran it as
# root. Check the media root and the folders in it, which is where a library
# that only another account can read shows up.
media="${MEDIA_CONTAINER_ROOT:-/mnt/media}"
if [[ -d "$media" ]]; then
  # find fails without printing when a directory above the media root keeps
  # the account out.
  unreadable="$(s6-setuidgid prairie find "$media" -maxdepth 1 \( ! -readable -o -type d ! -executable \) -print -quit 2>/dev/null)" ||
    unreadable="$media"
  if [[ -n "$unreadable" ]]; then
    warn "uid $PUID cannot read $unreadable; set PUID and PGID to an account that can read the media"
  fi
fi

cat <<BANNER
───────────────────────────────────────
Prairie omnibus
prairie uid: $(id -u prairie)
prairie gid: $(id -g prairie)
───────────────────────────────────────
BANNER
