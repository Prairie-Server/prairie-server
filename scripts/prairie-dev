#!/usr/bin/env bash
# Talk to a running Prairie deployment — local or over SSH — using the settings in
# `.prairie-dev.env`. Run `scripts/prairie-dev help` for the subcommands.
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
env_file=${PRAIRIE_DEV_ENV_FILE:-"$repo_root/.prairie-dev.env"}

if [[ -f "$env_file" ]]; then
	set -a
	# shellcheck disable=SC1090
	. "$env_file"
	set +a
fi

PRAIRIE_URL=${PRAIRIE_URL:-http://localhost:8090}
PRAIRIE_SSH=${PRAIRIE_SSH:-}
PRAIRIE_DIR=${PRAIRIE_DIR:-/opt/prairie}
PRAIRIE_COMPOSE_FILE=${PRAIRIE_COMPOSE_FILE:-docker-compose.yml}
PRAIRIE_SERVICE=${PRAIRIE_SERVICE:-prairie}
PRAIRIE_POSTGRES_SERVICE=${PRAIRIE_POSTGRES_SERVICE:-postgres}
PRAIRIE_DB_USER=${PRAIRIE_DB_USER:-prairie}
PRAIRIE_DB_NAME=${PRAIRIE_DB_NAME:-prairie}

die() {
	printf 'prairie-dev: %s\n' "$1" >&2
	exit 1
}

need_env_file() {
	[[ -f "$env_file" ]] || die "no ${env_file##*/} — copy .prairie-dev.env.example to .prairie-dev.env and fill it in"
}

# Run a shell command on whichever host Prairie runs on.
on_host() {
	if [[ -n "$PRAIRIE_SSH" ]]; then
		ssh "$PRAIRIE_SSH" "$@"
	else
		bash -lc "$@"
	fi
}

compose() {
	on_host "cd $(printf '%q' "$PRAIRIE_DIR") && COMPOSE_FILE=$(printf '%q' "$PRAIRIE_COMPOSE_FILE") docker compose $*"
}

# POST /auth/login and print the access token.
token() {
	need_env_file
	[[ -n "${PRAIRIE_ADMIN_USER:-}" && -n "${PRAIRIE_ADMIN_PASSWORD:-}" ]] ||
		die "set PRAIRIE_ADMIN_USER and PRAIRIE_ADMIN_PASSWORD in ${env_file##*/}"

	local body
	body=$(PRAIRIE_ADMIN_USER="$PRAIRIE_ADMIN_USER" PRAIRIE_ADMIN_PASSWORD="$PRAIRIE_ADMIN_PASSWORD" \
		python3 -c 'import json,os;print(json.dumps({"username":os.environ["PRAIRIE_ADMIN_USER"],"password":os.environ["PRAIRIE_ADMIN_PASSWORD"]}))')

	curl -fsS -X POST "$PRAIRIE_URL/api/v2/auth/login" \
		-H 'Content-Type: application/json' \
		--data-binary "$body" |
		python3 -c 'import json,sys;print(json.load(sys.stdin)["access_token"])'
}

usage() {
	cat <<'EOF'
usage: scripts/prairie-dev <command> [args]

  doctor                 check config and reachability, then report what works
  env                    print the resolved settings (secrets masked)
  sh <command...>        run a shell command on the host running Prairie
  compose <args...>      docker compose against the deployment's stack
  logs [args...]         compose logs for the Prairie service (default: --tail 200)
  psql <sql>             run one SQL statement against the Prairie database
  token                  print an access token for PRAIRIE_ADMIN_USER
  api <path> [curl...]   authenticated request as the admin's primary profile, e.g. api /api/v2/catalog

Settings come from .prairie-dev.env (see .prairie-dev.env.example). With PRAIRIE_SSH
empty, host commands run locally.
EOF
}

cmd=${1:-help}
if [[ $# -gt 0 ]]; then shift; fi

case "$cmd" in
help | -h | --help)
	usage
	;;

env)
	mask() { [[ -n "${1:-}" ]] && printf 'set' || printf 'empty'; }
	cat <<EOF
config file        $env_file $([[ -f "$env_file" ]] && echo '(found)' || echo '(MISSING)')
PRAIRIE_URL           $PRAIRIE_URL
PRAIRIE_SSH           ${PRAIRIE_SSH:-<local>}
PRAIRIE_DIR           $PRAIRIE_DIR
PRAIRIE_COMPOSE_FILE  $PRAIRIE_COMPOSE_FILE
PRAIRIE_SERVICE       $PRAIRIE_SERVICE
database           $PRAIRIE_DB_USER@$PRAIRIE_POSTGRES_SERVICE/$PRAIRIE_DB_NAME
PRAIRIE_ADMIN_USER    ${PRAIRIE_ADMIN_USER:-<unset>}
PRAIRIE_ADMIN_PASSWORD $(mask "${PRAIRIE_ADMIN_PASSWORD:-}")
PRAIRIE_MEDIA_ROOT    ${PRAIRIE_MEDIA_ROOT:-<unset>}
EOF
	;;

doctor)
	need_env_file
	status=0
	printf 'api      '
	# /api/v1/health is a retained operational probe, not part of the frozen v1 contract.
	if curl -fsS --max-time 10 "$PRAIRIE_URL/api/v1/health" >/dev/null 2>&1; then
		printf 'ok (%s)\n' "$PRAIRIE_URL"
	else
		printf 'FAIL — %s/api/v1/health did not respond\n' "$PRAIRIE_URL"
		status=1
	fi

	printf 'host     '
	if on_host 'true' >/dev/null 2>&1; then
		printf 'ok (%s)\n' "${PRAIRIE_SSH:-local}"
	else
		printf 'FAIL — cannot run commands on %s\n' "${PRAIRIE_SSH:-local shell}"
		status=1
	fi

	printf 'compose  '
	if compose ps --services >/dev/null 2>&1; then
		printf 'ok (%s in %s)\n' "$PRAIRIE_COMPOSE_FILE" "$PRAIRIE_DIR"
	else
		printf 'FAIL — no compose stack at %s\n' "$PRAIRIE_DIR"
		status=1
	fi

	printf 'database '
	if compose "exec -T $PRAIRIE_POSTGRES_SERVICE psql -U $PRAIRIE_DB_USER -d $PRAIRIE_DB_NAME -tAc 'select 1'" >/dev/null 2>&1; then
		printf 'ok (%s/%s)\n' "$PRAIRIE_DB_USER" "$PRAIRIE_DB_NAME"
	else
		printf 'FAIL — psql as %s on %s failed; check POSTGRES_USER/POSTGRES_DB in the deployment .env\n' \
			"$PRAIRIE_DB_USER" "$PRAIRIE_DB_NAME"
		status=1
	fi

	printf 'auth     '
	if [[ -z "${PRAIRIE_ADMIN_USER:-}" ]]; then
		printf 'skipped — PRAIRIE_ADMIN_USER not set\n'
	elif token >/dev/null 2>&1; then
		printf 'ok (%s)\n' "$PRAIRIE_ADMIN_USER"
	else
		printf 'FAIL — login rejected for %s\n' "$PRAIRIE_ADMIN_USER"
		status=1
	fi
	exit "$status"
	;;

sh)
	[[ $# -gt 0 ]] || die 'sh needs a command'
	on_host "$*"
	;;

compose)
	compose "$*"
	;;

logs)
	compose "logs $PRAIRIE_SERVICE ${*:---tail 200}"
	;;

psql)
	[[ $# -gt 0 ]] || die 'psql needs a SQL statement'
	sql=$*
	compose "exec -T $PRAIRIE_POSTGRES_SERVICE psql -U $PRAIRIE_DB_USER -d $PRAIRIE_DB_NAME -P pager=off -c $(printf '%q' "$sql")"
	;;

token)
	token
	;;

api)
	[[ $# -gt 0 ]] || die 'api needs a path, e.g. /api/v2/libraries'
	path=$1
	shift
	# Profile-scoped v2 reads (catalog, home, notifications, ...) need the
	# primary profile; resolve it once so the helper works for either kind.
	local_token=$(token)
	profile_id=$(curl -fsS -H "Authorization: Bearer $local_token" "$PRAIRIE_URL/api/v2/profiles" |
		python3 -c 'import json,sys
items=json.load(sys.stdin).get("items",[])
print(next((p["id"] for p in items if p.get("is_primary")), items[0]["id"] if items else ""))' 2>/dev/null || true)
	if [[ -z $profile_id ]]; then
		curl -fsS -H "Authorization: Bearer $local_token" "$PRAIRIE_URL$path" "$@"
		exit
	fi
	# A PIN-locked primary profile also needs X-Profile-Token; mint one from
	# PRAIRIE_ADMIN_PROFILE_PIN when it is configured.
	profile_headers=(-H "X-Profile-Id: $profile_id")
	if [[ -n "${PRAIRIE_ADMIN_PROFILE_PIN:-}" ]]; then
		pin_body=$(PRAIRIE_ADMIN_PROFILE_PIN="$PRAIRIE_ADMIN_PROFILE_PIN" python3 -c 'import json,os;print(json.dumps({"pin":os.environ["PRAIRIE_ADMIN_PROFILE_PIN"]}))')
		profile_token=$(curl -fsS -X POST "$PRAIRIE_URL/api/v2/profiles/$profile_id/verify-pin" \
			-H "Authorization: Bearer $local_token" -H 'Content-Type: application/json' --data-binary "$pin_body" |
			python3 -c 'import json,sys;print(json.load(sys.stdin).get("profile_token",""))' 2>/dev/null || true)
		[[ -n $profile_token ]] && profile_headers+=(-H "X-Profile-Token: $profile_token")
	fi
	curl -fsS -H "Authorization: Bearer $local_token" "${profile_headers[@]}" "$PRAIRIE_URL$path" "$@"
	;;

*)
	usage >&2
	die "unknown command: $cmd"
	;;
esac
